{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reset90.local/schemas/weekly-review.schema.json",
  "type": "object",
  "properties": {
    "week_number": { "type": "integer", "minimum": 1, "maximum": 13 },
    "date_from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "date_to": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "pattern": "\\S"
    },
    "wins": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "blockers": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "patterns": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "required": ["title", "evidence"],
        "additionalProperties": false
      }
    },
    "recommended_changes": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "next_week_commitments": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "green_days": { "type": "integer", "minimum": 0, "maximum": 7 },
        "yellow_days": { "type": "integer", "minimum": 0, "maximum": 7 },
        "blue_days": { "type": "integer", "minimum": 0, "maximum": 7 },
        "red_days": { "type": "integer", "minimum": 0, "maximum": 7 },
        "gold_days": { "type": "integer", "minimum": 0, "maximum": 7 },
        "recovery_credits_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        }
      },
      "required": [
        "green_days",
        "yellow_days",
        "blue_days",
        "red_days",
        "gold_days",
        "recovery_credits_used"
      ],
      "additionalProperties": false
    },
    "context_snapshot": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "reasoning_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "tags": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          }
        }
      },
      "required": ["title", "summary", "reasoning_summary", "tags"],
      "additionalProperties": false
    }
  },
  "required": [
    "week_number",
    "date_from",
    "date_to",
    "summary",
    "wins",
    "blockers",
    "patterns",
    "recommended_changes",
    "next_week_commitments",
    "metrics",
    "context_snapshot"
  ],
  "additionalProperties": false,
  "title": "Reset90 Weekly Review Payload"
}
