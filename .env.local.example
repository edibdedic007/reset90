# Local developer-only environment
NODE_ENV=development
AUTH_MODE=dev
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=debug

# Optional local OIDC test mode:
# Set AUTH_MODE=oidc and fill AUTH_SECRET plus AUTH_AUTHENTIK_* values.
# AUTH_SECRET=replace-with-32-plus-random-characters
# AUTH_AUTHENTIK_ID=reset90-local
# AUTH_AUTHENTIK_SECRET=replace-with-local-authentik-client-secret
# AUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/reset90/
# AUTH_TRUST_HOST=true

POSTGRES_USER=reset90
POSTGRES_PASSWORD=reset90_dev_password
POSTGRES_DB=reset90
DATABASE_URL=postgresql://reset90:reset90_dev_password@localhost:5432/reset90

GPT_INGEST_TOKEN=local-dev-token-change-me
GPT_INGEST_OWNER_SUBJECT=local-dev-user

EXPORT_DIR=./exports
BACKUP_DIR=./backups

APP_VERSION=0.1.0
GIT_COMMIT=local
