{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reset90.local/schemas/daily-reflection.schema.json",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "day_number": { "type": "integer", "minimum": 1, "maximum": 90 },
    "phase": {
      "type": "string",
      "enum": ["Clear the Fog", "Rebuild Momentum", "Prove Continuation"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "what_happened": { "type": "string", "maxLength": 1500 },
    "what_worked": { "type": "string", "maxLength": 1500 },
    "what_blocked_me": { "type": "string", "maxLength": 1500 },
    "tomorrow_adjustment": { "type": "string", "maxLength": 1500 },
    "self_criticism_note": { "type": "string", "maxLength": 1000 },
    "day_status_recommendation": {
      "type": "string",
      "enum": ["green", "yellow", "blue", "red", "gold", "unset"]
    }
  },
  "required": ["date", "day_number", "summary"],
  "additionalProperties": false,
  "title": "Reset90 Daily Reflection Payload"
}
