# Copy to .env.production, replace every placeholder, and keep that file untracked.
NODE_ENV=production
AUTH_MODE=oidc
APP_URL=https://reset90.example.com
PORT=3000

POSTGRES_USER=reset90
POSTGRES_PASSWORD=replace-with-long-random-database-password
POSTGRES_DB=reset90
DATABASE_URL=postgresql://reset90:replace-with-url-encoded-password@db:5432/reset90

AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
AUTH_AUTHENTIK_ID=replace-with-authentik-client-id
AUTH_AUTHENTIK_SECRET=replace-with-authentik-client-secret
AUTH_AUTHENTIK_ISSUER=https://auth.example.com/application/o/reset90

GPT_INGEST_TOKEN=replace-with-separate-long-random-gpt-token
GPT_INGEST_OWNER_SUBJECT=replace-with-owner-authentik-subject

EXPORT_DIR=/app/exports
BACKUP_DIR=/app/backups

APP_VERSION=replace-with-release-version
GIT_COMMIT=0000000000000000000000000000000000000000

RESET90_HOST=reset90.example.com
TRAEFIK_NETWORK=replace-with-existing-traefik-network
TRAEFIK_ENTRYPOINT=replace-with-https-entrypoint
TRAEFIK_CERT_RESOLVER=replace-with-certificate-resolver
