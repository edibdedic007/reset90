generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CycleStatus {
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("cycle_status")
}

enum EnergyLevel {
  BURNED_OUT
  LOW
  NORMAL
  HIGH
  RESTLESS_CHAOTIC

  @@map("energy_level")
}

enum DayStatus {
  GREEN
  YELLOW
  BLUE
  RED
  GOLD
  UNSET

  @@map("day_status")
}

enum PayloadKind {
  DAILY_PLAN
  DAILY_REFLECTION
  WEEKLY_REVIEW
  CONTEXT_ITEM

  @@map("payload_kind")
}

enum ValidationStatus {
  PENDING
  VALID
  INVALID

  @@map("validation_status")
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  REJECTED
  FAILED

  @@map("processing_status")
}

enum FocusDomain {
  BODY
  MOOD
  DIGITAL
  LEARNING
  WORK
  SYSTEM
  ENVIRONMENT
  SOCIAL
  OTHER

  @@map("focus_domain")
}

enum TaskTier {
  NON_NEGOTIABLE
  MINIMUM
  STANDARD
  IDEAL

  @@map("task_tier")
}

enum CheckinKind {
  MORNING
  MIDDAY
  EVENING
  MANUAL

  @@map("checkin_kind")
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  authentikSubject String       @unique @map("authentik_subject")
  email            String?      @unique
  displayName      String?      @map("display_name")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  resetCycles      ResetCycle[]

  @@map("users")
}

model ResetCycle {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  name                String
  startDate           DateTime     @map("start_date") @db.Date
  endDate             DateTime     @map("end_date") @db.Date
  status              CycleStatus  @default(ACTIVE)
  recoveryCreditLimit Int          @default(6) @map("recovery_credit_limit")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases              ResetPhase[]
  dayLogs             DayLog[]
  recoveryEvents      RecoveryEvent[]

  @@unique([userId, name])
  @@index([userId, status])
  @@map("reset_cycles")
}

model ResetPhase {
  id          String     @id @default(uuid()) @db.Uuid
  cycleId     String     @map("cycle_id") @db.Uuid
  name        String
  dayStart    Int        @map("day_start")
  dayEnd      Int        @map("day_end")
  description String?
  cycle       ResetCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  dayLogs     DayLog[]

  @@unique([cycleId, dayStart])
  @@map("reset_phases")
}

model DayLog {
  id                String       @id @default(uuid()) @db.Uuid
  cycleId           String       @map("cycle_id") @db.Uuid
  phaseId           String       @map("phase_id") @db.Uuid
  date              DateTime     @db.Date
  dayNumber         Int          @map("day_number")
  energyLevel       EnergyLevel? @map("energy_level")
  status            DayStatus    @default(UNSET)
  mission           String?
  supportiveMessage String?      @map("supportive_message")
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  cycle             ResetCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  phase             ResetPhase   @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  dailyPlan         DailyPlan?
  checkins          Checkin[]
  recoveryEvent     RecoveryEvent?

  @@unique([cycleId, date])
  @@unique([cycleId, dayNumber])
  @@index([phaseId])
  @@map("day_logs")
}

model ImportedPayload {
  id                     String           @id @default(uuid()) @db.Uuid
  kind                   PayloadKind
  schemaVersion          String           @map("schema_version")
  idempotencyKey         String           @map("idempotency_key")
  source                 String
  externalConversationId String?          @map("external_conversation_id")
  rawJson                Json             @map("raw_json")
  validationStatus       ValidationStatus @default(PENDING) @map("validation_status")
  processingStatus       ProcessingStatus @default(PENDING) @map("processing_status")
  errorMetadata          Json?            @map("error_metadata")
  processedAt            DateTime?        @map("processed_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  dailyPlan              DailyPlan?

  @@unique([source, idempotencyKey])
  @@index([kind, createdAt])
  @@map("imported_payloads")
}

model DailyPlan {
  id                String          @id @default(uuid()) @db.Uuid
  dayLogId          String          @unique @map("day_log_id") @db.Uuid
  importedPayloadId String          @unique @map("imported_payload_id") @db.Uuid
  source            String
  schemaVersion     String          @map("schema_version")
  mission           String
  supportiveMessage String          @map("supportive_message")
  warnings          Json
  downshiftRule     String          @map("downshift_rule")
  contextSummary    String          @map("context_summary")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  dayLog            DayLog          @relation(fields: [dayLogId], references: [id], onDelete: Cascade)
  importedPayload   ImportedPayload @relation(fields: [importedPayloadId], references: [id], onDelete: Restrict)
  tasks             Task[]

  @@map("daily_plans")
}

model Task {
  id              String      @id @default(uuid()) @db.Uuid
  dailyPlanId     String      @map("daily_plan_id") @db.Uuid
  title           String
  description     String?
  domain          FocusDomain
  tier            TaskTier
  estimateMinutes Int?        @map("estimate_minutes")
  trigger         String?
  why             String?
  completedAt     DateTime?   @map("completed_at")
  skippedAt       DateTime?   @map("skipped_at")
  notes           String?
  sortOrder       Int         @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  dailyPlan       DailyPlan   @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  @@index([dailyPlanId, tier, sortOrder])
  @@index([domain])
  @@map("tasks")
}

model Checkin {
  id                      String      @id @default(uuid()) @db.Uuid
  dayLogId                String      @map("day_log_id") @db.Uuid
  kind                    CheckinKind
  timestamp               DateTime    @default(now())
  energyLevel             EnergyLevel @map("energy_level")
  moodScore               Int         @map("mood_score")
  fogScore                Int         @map("fog_score")
  lonelinessScore         Int         @map("loneliness_score")
  selfCriticismScore      Int         @map("self_criticism_score")
  digitalControlScore     Int         @map("digital_control_score")
  learningResistanceScore Int         @map("learning_resistance_score")
  bodyRelationshipScore   Int         @map("body_relationship_score")
  workConfidenceScore     Int         @map("work_confidence_score")
  note                    String?
  dayLog                  DayLog      @relation(fields: [dayLogId], references: [id], onDelete: Cascade)

  @@index([dayLogId, timestamp])
  @@map("checkins")
}

model RecoveryEvent {
  id                String     @id @default(uuid()) @db.Uuid
  cycleId           String     @map("cycle_id") @db.Uuid
  dayLogId          String     @unique @map("day_log_id") @db.Uuid
  selectedActionIds Json       @default("[]") @map("selected_action_ids")
  startedAt         DateTime   @default(now()) @map("started_at")
  completedAt       DateTime?  @map("completed_at")
  creditConsumedAt  DateTime?  @map("credit_consumed_at")
  cycle             ResetCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  dayLog            DayLog     @relation(fields: [dayLogId], references: [id], onDelete: Cascade)

  @@index([cycleId, creditConsumedAt])
  @@map("recovery_events")
}
